# Dev container for flepimop2-epiworldr.
#
# Based on the same image epiworldR itself develops against, so R and epiworld
# behave identically here and in the model's own repo. Python tooling is added
# on top because this provider is a Python package that shells out to R.
FROM ghcr.io/rocker-org/devcontainer/r-ver:4.6

# epiworldR is the model; jsonlite carries the request across the bridge;
# data.table and ggplot2 back the replicate-aggregation example.
RUN install2.r --error --skipinstalled \
    epiworldR \
    jsonlite \
    data.table \
    ggplot2

# uv owns the Python toolchain, matching flepimop2's own workflow.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy

# just runs the same recipes locally and in CI.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) target='x86_64-unknown-linux-musl' ;; \
      arm64) target='aarch64-unknown-linux-musl' ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/casey/just/releases/download/1.42.4/just-1.42.4-${target}.tar.gz" \
      | tar -xz -C /usr/local/bin just

# Architecture-specific variable (built in Docker BuildKit)
ARG TARGETARCH

ARG QUARTO_VERSION=1.10.18

RUN wget https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb && \
    dpkg -i quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb && \
    rm quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb

CMD ["bash"]
