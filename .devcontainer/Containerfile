# Dev container for flepimop2-epiworld.
#
# epiworld runs in-process through epiworldpy's prebuilt wheels, so all this
# image needs is Python tooling: uv resolves Python itself from the lockfile.
FROM mcr.microsoft.com/devcontainers/python:3.13

# uv owns the Python toolchain, matching flepimop2's own workflow.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy

# just runs the same recipes locally and in CI.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "${arch}" in \
      amd64) target='x86_64-unknown-linux-musl' ;; \
      arm64) target='aarch64-unknown-linux-musl' ;; \
      *) echo "unsupported architecture: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/casey/just/releases/download/1.42.4/just-1.42.4-${target}.tar.gz" \
      | tar -xz -C /usr/local/bin just

# Architecture-specific variable (built in Docker BuildKit)
ARG TARGETARCH

# quarto renders README.qmd.
ARG QUARTO_VERSION=1.10.18

RUN wget https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb && \
    dpkg -i quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb && \
    rm quarto-${QUARTO_VERSION}-linux-${TARGETARCH}.deb

CMD ["bash"]
